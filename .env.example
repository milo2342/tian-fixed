# Discord Developer Portal -> your application -> Bot
DISCORD_BOT_TOKEN=

# Discord Developer Portal -> General Information -> Application ID
DISCORD_CLIENT_ID=

# Optional: use this while testing to register commands instantly in one server.
# Global registration can take up to about one hour to propagate.
DISCORD_GUILD_ID=

# PostgreSQL connection string
DATABASE_URL=

NODE_ENV=production
LOG_LEVEL=info

# Optional Gmail payment notification watcher
GMAIL_ADDRESS=tyrone.psrp@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_QUERY=from:noreply@tebex.io newer_than:7d
GMAIL_POLL_MS=30000
